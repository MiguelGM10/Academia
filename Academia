CREATE VIEW vw_modalidades_custo_estimado AS
SELECT
    m.nome AS modalidade,
    m.sala,
    p.nome AS plano,
    p.valor_mensal_base * 1.10 AS valor_mensal_ajustado
FROM modalidades m
JOIN planos p ON m.plano_id = p.id
ORDER BY valor_mensal_ajustado DESC;

CREATE VIEW vw_matriculas_ativas AS
SELECT
    a.nome AS aluno,
    a.cpf,
    mo.nome AS modalidade,
    mo.sala,
    i.duracao_meses,
    ma.data_inicio
FROM matriculas ma
JOIN alunos a ON ma.aluno_id = a.id
JOIN itens_matricula i ON ma.id = i.matricula_id
JOIN modalidades mo ON i.modalidade_id = mo.id
WHERE ma.status = 'Ativa';

CREATE VIEW vw_alunos_vip AS
SELECT
    a.nome AS aluno,
    COUNT(DISTINCT ma.id) AS quantidade_contratos_ativos,
    SUM((i.valor_mensal_aplicado * i.duracao_meses) + i.taxa_adesao) AS valor_total_investido
FROM alunos a
JOIN matriculas ma ON a.id = ma.aluno_id
JOIN itens_matricula i ON ma.id = i.matricula_id
WHERE ma.status = 'Ativa'
GROUP BY a.id, a.nome
HAVING SUM((i.valor_mensal_aplicado * i.duracao_meses) + i.taxa_adesao) > 1000.00;

SELECT
    m.nome AS modalidade,
    m.sala,
    m.capacidade_maxima,
    p.nome AS plano,
    p.valor_mensal_base
FROM modalidades m
JOIN planos p ON m.plano_id = p.id
WHERE m.capacidade_maxima >= 15
AND p.valor_mensal_base > 100.00
AND m.disponivel = TRUE;

CREATE VIEW vw_faturamento_medio_plano AS
SELECT
    p.nome AS plano,
    COALESCE(SUM((i.valor_mensal_aplicado * i.duracao_meses) + i.taxa_adesao), 0) AS faturamento_total,
    AVG(i.duracao_meses) AS media_duracao_meses
FROM planos p
LEFT JOIN modalidades mo ON p.id = mo.plano_id
LEFT JOIN itens_matricula i ON mo.id = i.modalidade_id
LEFT JOIN matriculas ma ON i.matricula_id = ma.id AND ma.status = 'Ativa'
GROUP BY p.id, p.nome;
